{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-native",
    "allowJs": true,
    "paths": {
      "@/*": [
        "./src/*"],
      "@assets/*": [
        "./assets/*"
      ],
    }
  },
  "include": [
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "**/*.ts",
    "**/*.tsx",
    "src/Shared/types/**/*.ts",
    "expo-env.d.ts",
    "src/app/context/AuthContext.ts",
    ".expo/types/**/*.ts"
  ]
}